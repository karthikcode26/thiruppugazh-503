# Never commit local environment or credentials
.env
.env.*

# Audio MP3s can be large (up to ~1-2 GB across 503 songs), so keep them out of
# Git and upload straight to S3 (deploy.sh syncs the local audio/ folder). The
# audio.json manifest IS committed; only the media files are ignored.
audio/
